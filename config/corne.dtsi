#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,physical-layout = &physical_layout0;
	};

	kscan0: kscan_0 {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";

		// rows: top, middle, bottom, thumb — identical wiring on both halves
		row-gpios
			= <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row0 - top
			, <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row1 - middle
			, <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row2 - bottom
			, <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row3 - thumb
			;

		// cols, listed in the same left-to-right physical order on BOTH halves.
		// No reversal here — that's what avoids the mirroring problem.
		col-gpios
			= <&gpio0 31 GPIO_ACTIVE_HIGH>   // col0
			, <&gpio0 29 GPIO_ACTIVE_HIGH>   // col1
			, <&gpio0 2  GPIO_ACTIVE_HIGH>   // col2
			, <&gpio1 15 GPIO_ACTIVE_HIGH>   // col3
			, <&gpio1 13 GPIO_ACTIVE_HIGH>   // col4
			, <&gpio1 11 GPIO_ACTIVE_HIGH>   // col5
			;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <4>;

		// left = cols 0-5, right = cols 6-11 (right overlay adds col-offset = <6>)
		// VERIFY: thumb cols assumed to be the middle three (2,3,4 / 8,9,10)
	map = 
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
			                RC(3,3) RC(3,4) RC(3,5)                   RC(3,9) RC(3,10) RC(3,11)
		>;
	};

	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Corne 42 (custom wiring)";
		transform = <&default_transform>;
		kscan = <&kscan0>;
	};
};