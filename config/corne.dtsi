#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    // THIS MAPS YOUR EXACT RAW ELECTRICAL CONNECTIONS STRAIGHT INTO THE LAYOUT
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <12>; // 6 columns on the left + 6 columns on the right

        // Left half maps left-to-right (0 to 5)
        // Right half maps left-to-right (6 to 11) because col-offset handles the shift!
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                RC(3,1) RC(3,2) RC(3,3)          RC(3,8) RC(3,9) RC(3,10)
        >;
    };
};

&kscan0 {
    diode-direction = "col2row";

    row-gpios
        = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 0
        , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 1
        , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 2
        , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 3 (Thumb Cluster Pin 100)
        ;

    col-gpios
        = <&gpio0 31 GPIO_ACTIVE_HIGH> // Col 0
        , <&gpio0 29 GPIO_ACTIVE_HIGH> // Col 1
        , <&gpio0 2  GPIO_ACTIVE_HIGH> // Col 2
        , <&gpio1 15 GPIO_ACTIVE_HIGH> // Col 3
        , <&gpio1 13 GPIO_ACTIVE_HIGH> // Col 4
        , <&gpio1 11 GPIO_ACTIVE_HIGH> // Col 5
        ;
};
